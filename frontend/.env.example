# Copie este archivo como .env y llene los datos del proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK).
# Si se deja vacío, la app funciona igual y las reseñas aparecen como "próximamente".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
